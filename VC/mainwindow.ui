  <property name="styleSheet">
   <string notr="true">QWidget { background-color: #1a1b26; color: #a9b1d6; font-family: 'Segoe UI', 'San Francisco', sans-serif; }

QMainWindow, QDialog { background-color: #1a1b26; }

QPushButton { 
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2e3440, stop:1 #24283b); 
  border: 1px solid #414868; border-radius: 8px; padding: 10px 18px; color: #c0caf5; 
  font-weight: 600; font-size: 13px; 
} 
QPushButton:hover { background: #414868; border-color: #7aa2f7; color: #fff; } 
QPushButton:pressed { background: #3d59a1; } 

#btnCycle { 
  background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #3d59a1, stop:1 #7aa2f7); 
  color: white; font-size: 14px; font-weight: bold; border: none; min-height: 40px; padding: 0 25px; 
} 
#btnCycle:hover { background: #7aa2f7; } 

QListWidget, QPlainTextEdit, QTextEdit, QLineEdit, QListView { 
  background-color: #24283b; border: 1px solid #414868; border-radius: 12px; 
  padding: 10px; color: #c0caf5; selection-background-color: #3d59a1; 
} 
QListWidget::item { padding: 10px; border-bottom: 1px solid #2f334d; margin: 2px 0; } 
QListWidget::item:selected { background-color: #3d59a1; border-radius: 8px; color: white; } 

QGroupBox { 
  background-color: #1f2335; border: 1px solid #414868; border-radius: 15px; 
  margin-top: 25px; padding-top: 20px; font-weight: bold; color: #7aa2f7; 
} 
QGroupBox::title { subcontrol-origin: margin; left: 15px; padding: 0 10px; background-color: #1a1b26; } 

QLabel { background-color: transparent; color: #a9b1d6; font-size: 14px; } 
#label_name { font-size: 20px; color: #7aa2f7; font-weight: 900; } 

QScrollBar:vertical { border: none; background: #1a1b26; width: 8px; margin: 0; } 
QScrollBar::handle:vertical { background: #414868; min-height: 20px; border-radius: 4px; } 
QScrollBar::handle:vertical:hover { background: #7aa2f7; }</string>
